// Embeds the application manifest as resource id 1, type 24 (RT_MANIFEST) —
// the standard way to attach a manifest without linker-specific flags. Odin
// takes this via -resource: (see build.bat).
1 24 "newtpad.manifest"

// Embeds newtpad.ico (generated by tools/gen_icon, see that file for the
// format and the artwork's source) as resource id 1 in the ICON namespace —
// a separate namespace from the manifest's id 1 above, so there is no
// collision. Windows Explorer shows the numerically-lowest icon-group
// resource in a module as the file's own icon, which is what makes this line
// alone enough to give the .exe its icon. The window/taskbar/Alt+Tab icon is
// a second, runtime step: window_create (window.odin) calls
// LoadIconW(hinstance, MAKEINTRESOURCEW(1)) and sets it on WNDCLASSEXW, using
// the same id 1 declared here.
1 ICON "newtpad.ico"

// A VERSIONINFO block, so the exe carries a company, a product name, a
// description and a version. Until 2026-07-31 it carried none of them:
// Get-Item on the shipped v0.33.0 returned empty for every one of those fields.
//
// That is not cosmetic. An unsigned binary with no version resource, freshly
// downloaded from the internet, is close to the exact shape of Windows
// Defender's machine-learning false positive -- and a GitHub download of
// newtpad.exe did fail with "Virus detected" in the browser. Signing is the
// bigger of the two signals and is still blocked on a certificate; this is the
// half that costs nothing. It is not a claim that metadata alone clears the
// flag, only that shipping without it leaves a free signal on the table.
//
// The numbers come from build\version.rh, generated by tools/gen-version-rh.ps1
// from NEWTPAD_VERSION in src/program/version.odin. rc gets -I build from
// build.bat. Do not type a version literal into this file: version.odin is the
// single source of truth that release.ps1 already greps for the git tag, and a
// second copy here would be a second thing to forget on a bump.
#include "version.rh"

1 VERSIONINFO
FILEVERSION    NEWTPAD_VER_COMMA
PRODUCTVERSION NEWTPAD_VER_COMMA
FILEOS         0x4L // VOS_NT
FILETYPE       0x1L // VFT_APP
{
	BLOCK "StringFileInfo"
	{
		// 040904B0 = US English, Unicode. The charset field must agree with the
		// Translation value in VarFileInfo below or the shell shows nothing.
		BLOCK "040904B0"
		{
			VALUE "CompanyName",      "Wyatt Guethlein"
			VALUE "FileDescription",  "Newtpad"
			VALUE "FileVersion",      NEWTPAD_VER_STR
			VALUE "InternalName",     "newtpad"
			// ASCII "(C)", not the copyright sign: this file is compiled by rc
			// under whatever codepage the build host has, and the project has
			// already shipped one mojibake em dash from exactly that class of
			// assumption (docs/development-loop.md, "Shell").
			VALUE "LegalCopyright",   "Copyright (C) 2026 Wyatt Guethlein"
			VALUE "OriginalFilename", "newtpad.exe"
			VALUE "ProductName",      "Newtpad"
			VALUE "ProductVersion",   NEWTPAD_VER_STR
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x409, 0x04B0
	}
}
